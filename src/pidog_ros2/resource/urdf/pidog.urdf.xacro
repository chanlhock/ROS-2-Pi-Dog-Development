<?xml version="1.0"?>
<robot name="pidog" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gazebo="http://gazebosim.org/schemas/gazebo">

  <!-- ==================== Constants ==================== -->
  <!-- Body dimensions (based on actual PiDog) -->
  <xacro:property name="body_length" value="0.18" />
  <xacro:property name="body_width" value="0.10" />
  <xacro:property name="body_height" value="0.045" />
  <xacro:property name="body_mass" value="0.75" />

  <!-- Leg dimensions -->
  <xacro:property name="upper_leg_length" value="0.075" />
  <xacro:property name="lower_leg_length" value="0.085" />
  <xacro:property name="leg_width" value="0.028" />
  <xacro:property name="leg_mass" value="0.06" />

  <!-- Joint positions (shoulder/hip on body sides) -->
  <xacro:property name="hip_front_offset_x" value="0.07" />
  <xacro:property name="hip_hind_offset_x" value="-0.07" />
  <xacro:property name="hip_offset_y" value="0.055" />
  <xacro:property name="hip_offset_z" value="0.005" />

  <!-- Head dimensions -->
  <xacro:property name="head_length" value="0.08" />
  <xacro:property name="head_width" value="0.065" />
  <xacro:property name="head_height" value="0.055" />
  <xacro:property name="head_mass" value="0.15" />
  <xacro:property name="head_offset_x" value="0.09" />
  <xacro:property name="head_offset_y" value="0.00" />
  <xacro:property name="head_offset_z" value="0.02" />

  <!-- Camera dimensions (mounted above head) -->
  <xacro:property name="camera_length" value="0.025" />
  <xacro:property name="camera_width" value="0.035" />
  <xacro:property name="camera_height" value="0.020" />
  <xacro:property name="camera_mass" value="0.015" />

  <!-- Tail -->
  <xacro:property name="tail_offset_x" value="-0.09" />
  <xacro:property name="tail_offset_y" value="0.00" />
  <xacro:property name="tail_offset_z" value="0.008" />
  <xacro:property name="tail_length" value="0.08" />
  <xacro:property name="tail_mass" value="0.015" />

  <!-- Electronics -->
  <xacro:property name="rpi_length" value="0.075" />
  <xacro:property name="rpi_width" value="0.050" />
  <xacro:property name="rpi_height" value="0.010" />
  <xacro:property name="rpi_mass" value="0.045" />
  
  <xacro:property name="hat_length" value="0.075" />
  <xacro:property name="hat_width" value="0.050" />
  <xacro:property name="hat_height" value="0.008" />
  <xacro:property name="hat_mass" value="0.022" />

  <!-- Colors -->
  <xacro:property name="body_color" value="0.30 0.30 0.35 1.0" />
  <xacro:property name="leg_color" value="0.25 0.25 0.28 1.0" />
  <xacro:property name="head_color" value="0.32 0.32 0.38 1.0" />
  <xacro:property name="camera_color" value="0.1 0.1 0.1 1.0" />
  <xacro:property name="rpi_color" value="0.0 0.5 0.0 1.0" />
  <xacro:property name="hat_color" value="0.0 0.0 0.7 1.0" />
  <xacro:property name="tail_color" value="0.28 0.28 0.32 1.0" />
  <xacro:property name="eye_color" value="1.0 1.0 1.0 1.0" />

  <!-- Materials -->
  <material name="body_material"><color rgba="${body_color}" /></material>
  <material name="leg_material"><color rgba="${leg_color}" /></material>
  <material name="head_material"><color rgba="${head_color}" /></material>
  <material name="camera_material"><color rgba="${camera_color}" /></material>
  <material name="rpi_material"><color rgba="${rpi_color}" /></material>
  <material name="hat_material"><color rgba="${hat_color}" /></material>
  <material name="tail_material"><color rgba="${tail_color}" /></material>
  <material name="eye_material"><color rgba="${eye_color}" /></material>
  <material name="lens_material"><color rgba="0.2 0.5 0.8 1.0" /></material>

  <!-- ==================== Gazebo Extensions ==================== -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/pidog</robotNamespace>
      <controlPeriod>0.01</controlPeriod>
    </plugin>
    <static>false</static>
  </gazebo>

  <!-- ==================== Base Link (Body) ==================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}" /></geometry>
      <origin xyz="0 0 0" />
      <material name="body_material" />
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}" /></geometry>
      <origin xyz="0 0 0" />
    </collision>
    <inertial>
      <mass value="${body_mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.005" />
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>

  <!-- ==================== Raspberry Pi (on top of body) ==================== -->
  <joint name="rpi_joint" type="fixed">
    <origin xyz="0 0 ${body_height/2 + rpi_height/2}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rpi_link" />
  </joint>

  <link name="rpi_link">
    <visual>
      <geometry><box size="${rpi_length} ${rpi_width} ${rpi_height}" /></geometry>
      <origin xyz="0 0 0" />
      <material name="rpi_material" />
    </visual>
    <collision>
      <geometry><box size="${rpi_length} ${rpi_width} ${rpi_height}" /></geometry>
      <origin xyz="0 0 0" />
    </collision>
    <inertial>
      <mass value="${rpi_mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004" />
    </inertial>
  </link>

  <!-- ==================== Robot HAT (above Pi) ==================== -->
  <joint name="hat_joint" type="fixed">
    <origin xyz="0 0 ${body_height/2 + rpi_height + hat_height/2}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="hat_link" />
  </joint>

  <link name="hat_link">
    <visual>
      <geometry><box size="${hat_length} ${hat_width} ${hat_height}" /></geometry>
      <origin xyz="0 0 0" />
      <material name="hat_material" />
    </visual>
    <collision>
      <geometry><box size="${hat_length} ${hat_width} ${hat_height}" /></geometry>
      <origin xyz="0 0 0" />
    </collision>
    <inertial>
      <mass value="${hat_mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000025" />
    </inertial>
  </link>

  <!-- ==================== Head Assembly ==================== -->
  <!-- Head yaw (left/right) -->
  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="${head_offset_x} ${head_offset_y} ${head_offset_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="head_pitch_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.2" upper="1.2" effort="1.5" velocity="2.5" />
    <dynamics damping="0.08" friction="0.04" />
  </joint>

  <link name="head_pitch_link">
    <inertial>
      <mass value="0.01" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
  </link>

  <!-- Head pitch (up/down) -->
  <joint name="head_pitch_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="head_pitch_link" />
    <child link="head_link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.6" upper="0.8" effort="1.5" velocity="2.5" />
    <dynamics damping="0.08" friction="0.04" />
  </joint>

  <!-- Main head -->
  <link name="head_link">
    <visual>
      <geometry><box size="${head_length} ${head_width} ${head_height}" /></geometry>
      <origin xyz="0 0 0" />
      <material name="head_material" />
    </visual>
    <!-- Eyes -->
    <visual name="left_eye">
      <geometry><sphere radius="0.006" /></geometry>
      <origin xyz="${head_length/2 - 0.005} ${head_width/3.5} ${head_height/5}" />
      <material name="eye_material" />
    </visual>
    <visual name="right_eye">
      <geometry><sphere radius="0.006" /></geometry>
      <origin xyz="${head_length/2 - 0.005} -${head_width/3.5} ${head_height/5}" />
      <material name="eye_material" />
    </visual>
    <collision>
      <geometry><box size="${head_length} ${head_width} ${head_height}" /></geometry>
      <origin xyz="0 0 0" />
    </collision>
    <inertial>
      <mass value="${head_mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
  </link>

  <!-- ==================== Camera (on top of head) ==================== -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="${head_length/2 - 0.01} 0 ${head_height/2 + camera_height/2}" rpy="0 0 0" />
    <parent link="head_link" />
    <child link="camera_link" />
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="${camera_length} ${camera_width} ${camera_height}" /></geometry>
      <origin xyz="0 0 0" />
      <material name="camera_material" />
    </visual>
    <!-- Camera lens -->
    <visual name="lens">
      <geometry><sphere radius="0.006" /></geometry>
      <origin xyz="${camera_length/2} 0 0" />
      <material name="lens_material" />
    </visual>
    <collision>
      <geometry><box size="${camera_length} ${camera_width} ${camera_height}" /></geometry>
      <origin xyz="0 0 0" />
    </collision>
    <inertial>
      <mass value="${camera_mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005" />
    </inertial>
  </link>

  <!-- ==================== Tail ==================== -->
  <joint name="tail_joint" type="revolute">
    <origin xyz="${tail_offset_x} ${tail_offset_y} ${tail_offset_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="tail_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.0" upper="1.0" effort="0.6" velocity="3.0" />
    <dynamics damping="0.05" friction="0.03" />
  </joint>

  <link name="tail_link">
    <visual>
      <geometry><cylinder radius="0.006" length="${tail_length}" /></geometry>
      <origin xyz="0 0 -${tail_length/2}" rpy="0.2 0 0" />
      <material name="tail_material" />
    </visual>
    <collision>
      <geometry><cylinder radius="0.006" length="${tail_length}" /></geometry>
      <origin xyz="0 0 -${tail_length/2}" rpy="0.2 0 0" />
    </collision>
    <inertial>
      <mass value="${tail_mass}" />
      <origin xyz="0 0 -${tail_length/2}" />
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000008" />
    </inertial>
  </link>

  <!-- ==================== Leg Macro ==================== -->
  <xacro:macro name="leg" params="prefix side x_offset y_offset z_offset">
    <!-- Hip joint -->
    <joint name="${prefix}_hip_joint" type="revolute">
      <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="${prefix}_upper_leg" />
      <axis xyz="0 1 0" />
      <limit lower="-1.2" upper="1.2" effort="2.0" velocity="3.0" />
      <dynamics damping="0.1" friction="0.05" />
    </joint>

    <link name="${prefix}_upper_leg">
      <visual>
        <geometry><box size="${leg_width} ${upper_leg_length} ${leg_width}" /></geometry>
        <origin xyz="0 -${upper_leg_length/2} 0" />
        <material name="leg_material" />
      </visual>
      <collision>
        <geometry><box size="${leg_width} ${upper_leg_length} ${leg_width}" /></geometry>
        <origin xyz="0 -${upper_leg_length/2} 0" />
      </collision>
      <inertial>
        <mass value="${leg_mass}" />
        <origin xyz="0 -${upper_leg_length/2} 0" />
        <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00008" />
      </inertial>
    </link>

    <!-- Knee joint -->
    <joint name="${prefix}_knee_joint" type="revolute">
      <origin xyz="0 -${upper_leg_length} 0" rpy="0 0 0" />
      <parent link="${prefix}_upper_leg" />
      <child link="${prefix}_lower_leg" />
      <axis xyz="0 1 0" />
      <limit lower="-1.6" upper="0.1" effort="1.5" velocity="3.0" />
      <dynamics damping="0.1" friction="0.05" />
    </joint>

    <link name="${prefix}_lower_leg">
      <visual>
        <geometry><box size="${leg_width*0.85} ${lower_leg_length} ${leg_width*0.85}" /></geometry>
        <origin xyz="0 -${lower_leg_length/2} 0" />
        <material name="leg_material" />
      </visual>
      <collision>
        <geometry><box size="${leg_width*0.85} ${lower_leg_length} ${leg_width*0.85}" /></geometry>
        <origin xyz="0 -${lower_leg_length/2} 0" />
      </collision>
      <inertial>
        <mass value="${leg_mass*0.7}" />
        <origin xyz="0 -${lower_leg_length/2} 0" />
        <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.00006" />
      </inertial>
    </link>

    <!-- Foot -->
    <joint name="${prefix}_foot_joint" type="fixed">
      <origin xyz="0 -${lower_leg_length} 0" rpy="0 0 0" />
      <parent link="${prefix}_lower_leg" />
      <child link="${prefix}_foot" />
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="0.010" /></geometry>
        <material name="leg_material" />
      </visual>
      <collision>
        <geometry><sphere radius="0.010" /></geometry>
      </collision>
      <inertial>
        <mass value="0.008" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.000004" ixy="0" ixz="0" iyy="0.000004" iyz="0" izz="0.000004" />
      </inertial>
    </link>

    <gazebo reference="${prefix}_foot">
      <material>Gazebo/Black</material>
      <mu1>0.7</mu1>
      <mu2>0.7</mu2>
      <restitution>0.5</restitution>
      <rolling_friction>0.001</rolling_friction>
    </gazebo>
  </xacro:macro>

  <!-- ==================== Instantiate Legs (Two per side) ==================== -->
  <!-- Front Left -->
  <xacro:leg prefix="front_left" side="left" 
             x_offset="${hip_front_offset_x}" 
             y_offset="${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

  <!-- Front Right -->
  <xacro:leg prefix="front_right" side="right" 
             x_offset="${hip_front_offset_x}" 
             y_offset="-${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

  <!-- Hind Left -->
  <xacro:leg prefix="hind_left" side="left" 
             x_offset="${hip_hind_offset_x}" 
             y_offset="${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

  <!-- Hind Right -->
  <xacro:leg prefix="hind_right" side="right" 
             x_offset="${hip_hind_offset_x}" 
             y_offset="-${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

  <!-- ==================== Camera Sensor Plugin (Gazebo) ==================== -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/pidog</namespace>
          <argument>camera/image_raw</argument>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== IMU Sensor ==================== -->
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/pidog</namespace>
          <argument>/imu/data</argument>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== World/Odom Links (Fixes KDL warning) ==================== -->
  <link name="world"/>
  <link name="odom"/>

  <joint name="world_odom_joint" type="fixed">
    <parent link="world"/>
    <child link="odom"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="odom_base_joint" type="fixed">
    <parent link="odom"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
