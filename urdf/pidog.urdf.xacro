<?xml version="1.0"?>
<robot name="pidog" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Constants ==================== -->
  <!-- Body dimensions based on actual PiDog -->
  <xacro:property name="body_length" value="0.22" />
  <xacro:property name="body_width" value="0.13" />
  <xacro:property name="body_height" value="0.055" />
  <xacro:property name="body_mass" value="0.9" />

  <!-- Leg segment dimensions (adjusted for realistic stance) -->
  <xacro:property name="upper_leg_length" value="0.085" />
  <xacro:property name="lower_leg_length" value="0.095" />
  <xacro:property name="leg_width" value="0.03" />
  <xacro:property name="leg_mass" value="0.05" />

  <!-- Head dimensions (more dog-like) -->
  <xacro:property name="head_length" value="0.09" />
  <xacro:property name="head_width" value="0.075" />
  <xacro:property name="head_height" value="0.065" />
  <xacro:property name="snout_length" value="0.04" />
  <xacro:property name="head_mass" value="0.18" />

  <!-- Hip joint offsets (positioned for realistic stance) -->
  <xacro:property name="hip_front_offset_x" value="0.085" />
  <xacro:property name="hip_hind_offset_x" value="-0.085" />
  <xacro:property name="hip_offset_y" value="0.065" />
  <xacro:property name="hip_offset_z" value="0.005" />

  <!-- Head offsets -->
  <xacro:property name="head_offset_x" value="0.11" />
  <xacro:property name="head_offset_y" value="0.00" />
  <xacro:property name="head_offset_z" value="0.025" />

  <!-- Tail offset -->
  <xacro:property name="tail_offset_x" value="-0.11" />
  <xacro:property name="tail_offset_y" value="0.00" />
  <xacro:property name="tail_offset_z" value="0.01" />

  <!-- Component dimensions -->
  <xacro:property name="rpi_length" value="0.085" />
  <xacro:property name="rpi_width" value="0.056" />
  <xacro:property name="rpi_height" value="0.012" />
  
  <xacro:property name="hat_length" value="0.085" />
  <xacro:property name="hat_width" value="0.056" />
  <xacro:property name="hat_height" value="0.008" />

  <!-- Colors -->
  <xacro:property name="body_color" value="0.35 0.35 0.35 1.0" />
  <xacro:property name="leg_color" value="0.25 0.25 0.25 1.0" />
  <xacro:property name="head_color" value="0.4 0.4 0.4 1.0" />
  <xacro:property name="snout_color" value="0.3 0.3 0.3 1.0" />
  <xacro:property name="rpi_color" value="0.0 0.6 0.0 1.0" />
  <xacro:property name="hat_color" value="0.0 0.0 0.8 1.0" />
  <xacro:property name="tail_color" value="0.25 0.25 0.25 1.0" />

  <!-- Materials -->
  <material name="body_material"><color rgba="${body_color}" /></material>
  <material name="leg_material"><color rgba="${leg_color}" /></material>
  <material name="head_material"><color rgba="${head_color}" /></material>
  <material name="snout_material"><color rgba="${snout_color}" /></material>
  <material name="rpi_material"><color rgba="${rpi_color}" /></material>
  <material name="hat_material"><color rgba="${hat_color}" /></material>
  <material name="tail_material"><color rgba="${tail_color}" /></material>
  <material name="eye_material"><color rgba="1.0 1.0 1.0 1.0" /></material>
  <material name="pupil_material"><color rgba="0.0 0.0 0.0 1.0" /></material>

  <!-- ==================== Base Link (Body) ==================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
      <origin xyz="0 0 0" />
      <material name="body_material" />
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="${body_mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.008" />
    </inertial>
  </link>

  <!-- ==================== Raspberry Pi 5 (on top of body) ==================== -->
  <joint name="rpi_joint" type="fixed">
    <origin xyz="0 0 ${body_height/2 + rpi_height/2}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rpi_link" />
  </joint>

  <link name="rpi_link">
    <visual>
      <geometry>
        <box size="${rpi_length} ${rpi_width} ${rpi_height}" />
      </geometry>
      <origin xyz="0 0 0" />
      <material name="rpi_material" />
    </visual>
    <inertial>
      <mass value="0.05" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <!-- ==================== Robot HAT Board (above Raspberry Pi) ==================== -->
  <joint name="hat_joint" type="fixed">
    <origin xyz="0 0 ${body_height/2 + rpi_height + hat_height/2}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="hat_link" />
  </joint>

  <link name="hat_link">
    <visual>
      <geometry>
        <box size="${hat_length} ${hat_width} ${hat_height}" />
      </geometry>
      <origin xyz="0 0 0" />
      <material name="hat_material" />
    </visual>
    <inertial>
      <mass value="0.03" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
    </inertial>
  </link>

  <!-- ==================== Head Assembly ==================== -->
  <!-- Head roll joint -->
  <joint name="head_roll_joint" type="revolute">
    <origin xyz="${head_offset_x} ${head_offset_y} ${head_offset_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="head_yaw_link" />
    <axis xyz="1 0 0" />
    <limit lower="-0.5" upper="0.5" effort="1.5" velocity="2.0" />
  </joint>

  <link name="head_yaw_link">
    <visual>
      <geometry><cylinder radius="0.015" length="0.025" /></geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0" />
      <material name="body_material" />
    </visual>
    <inertial>
      <mass value="0.02" />
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
    </inertial>
  </link>

  <!-- Head yaw joint -->
  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="head_yaw_link" />
    <child link="head_pitch_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.4" upper="1.4" effort="1.5" velocity="2.0" />
  </joint>

  <link name="head_pitch_link">
    <inertial>
      <mass value="0.015" />
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003" />
    </inertial>
  </link>

  <!-- Head pitch joint -->
  <joint name="head_pitch_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="head_pitch_link" />
    <child link="head_link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.7" upper="0.7" effort="1.5" velocity="2.0" />
  </joint>

  <!-- Main head -->
  <link name="head_link">
    <visual>
      <geometry><box size="${head_length} ${head_width} ${head_height}" /></geometry>
      <origin xyz="0 0 0" />
      <material name="head_material" />
    </visual>
    <!-- Snout -->
    <visual name="snout">
      <geometry><box size="${snout_length} ${head_width*0.6} ${head_height*0.5}" /></geometry>
      <origin xyz="${head_length/2 + snout_length/2} 0 -${head_height/6}" />
      <material name="snout_material" />
    </visual>
    <!-- Eyes -->
    <visual name="left_eye">
      <geometry><sphere radius="0.007" /></geometry>
      <origin xyz="${head_length/2 - 0.005} ${head_width/3.5} ${head_height/4}" />
      <material name="eye_material" />
    </visual>
    <visual name="left_pupil">
      <geometry><sphere radius="0.0035" /></geometry>
      <origin xyz="${head_length/2 - 0.003} ${head_width/3.5} ${head_height/4}" />
      <material name="pupil_material" />
    </visual>
    <visual name="right_eye">
      <geometry><sphere radius="0.007" /></geometry>
      <origin xyz="${head_length/2 - 0.005} -${head_width/3.5} ${head_height/4}" />
      <material name="eye_material" />
    </visual>
    <visual name="right_pupil">
      <geometry><sphere radius="0.0035}" /></geometry>
      <origin xyz="${head_length/2 - 0.003} -${head_width/3.5} ${head_height/4}" />
      <material name="pupil_material" />
    </visual>
    <collision>
      <geometry><box size="${head_length} ${head_width} ${head_height}" /></geometry>
    </collision>
    <inertial>
      <mass value="${head_mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006" />
    </inertial>
  </link>

  <!-- ==================== Tail ==================== -->
  <joint name="tail_base_joint" type="revolute">
    <origin xyz="${tail_offset_x} ${tail_offset_y} ${tail_offset_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="tail_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.2" upper="1.2" effort="0.8" velocity="3.0" />
  </joint>

  <link name="tail_link">
    <visual>
      <geometry><cylinder radius="0.007" length="0.095" /></geometry>
      <origin xyz="0 0 -0.0475" rpy="0.3 0 0" />
      <material name="tail_material" />
    </visual>
    <collision>
      <geometry><cylinder radius="0.007" length="0.095" /></geometry>
      <origin xyz="0 0 -0.0475" rpy="0.3 0 0" />
    </collision>
    <inertial>
      <mass value="0.02" />
      <origin xyz="0 0 -0.0475" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005" />
    </inertial>
  </link>

  <!-- ==================== Leg Macro ==================== -->
  <xacro:macro name="leg" params="prefix side x_offset y_offset z_offset">
    <!-- Hip joint -->
    <joint name="${prefix}_hip_joint" type="revolute">
      <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="${prefix}_upper_leg" />
      <axis xyz="0 1 0" />
      <limit lower="-1.4" upper="1.4" effort="2.0" velocity="3.0" />
    </joint>

    <link name="${prefix}_upper_leg">
      <visual>
        <geometry><box size="${leg_width} ${upper_leg_length} ${leg_width}" /></geometry>
        <origin xyz="0 -${upper_leg_length/2} 0" />
        <material name="leg_material" />
      </visual>
      <collision>
        <geometry><box size="${leg_width} ${upper_leg_length} ${leg_width}" /></geometry>
        <origin xyz="0 -${upper_leg_length/2} 0" />
      </collision>
      <inertial>
        <mass value="${leg_mass}" />
        <origin xyz="0 -${upper_leg_length/2} 0" />
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005" />
      </inertial>
    </link>

    <!-- Knee joint -->
    <joint name="${prefix}_knee_joint" type="revolute">
      <origin xyz="0 -${upper_leg_length} 0" rpy="0 0 0" />
      <parent link="${prefix}_upper_leg" />
      <child link="${prefix}_lower_leg" />
      <axis xyz="0 1 0" />
      <limit lower="-1.8" upper="0.2" effort="1.5" velocity="3.0" />
    </joint>

    <link name="${prefix}_lower_leg">
      <visual>
        <geometry><box size="${leg_width*0.85} ${lower_leg_length} ${leg_width*0.85}" /></geometry>
        <origin xyz="0 -${lower_leg_length/2} 0" />
        <material name="leg_material" />
      </visual>
      <collision>
        <geometry><box size="${leg_width*0.85} ${lower_leg_length} ${leg_width*0.85}" /></geometry>
        <origin xyz="0 -${lower_leg_length/2} 0" />
      </collision>
      <inertial>
        <mass value="${leg_mass*0.8}" />
        <origin xyz="0 -${lower_leg_length/2} 0" />
        <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0004" />
      </inertial>
    </link>

    <!-- Foot -->
    <joint name="${prefix}_foot_joint" type="fixed">
      <origin xyz="0 -${lower_leg_length} 0" rpy="0 0 0" />
      <parent link="${prefix}_lower_leg" />
      <child link="${prefix}_foot" />
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="0.011" /></geometry>
        <material name="leg_material" />
      </visual>
      <inertial>
        <mass value="0.008" />
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
      </inertial>
    </link>
  </xacro:macro>

  <!-- ==================== Instantiate Legs ==================== -->
  <xacro:leg prefix="front_left" side="left" 
             x_offset="${hip_front_offset_x}" 
             y_offset="${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

  <xacro:leg prefix="front_right" side="right" 
             x_offset="${hip_front_offset_x}" 
             y_offset="-${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

  <xacro:leg prefix="hind_left" side="left" 
             x_offset="${hip_hind_offset_x}" 
             y_offset="${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

  <xacro:leg prefix="hind_right" side="right" 
             x_offset="${hip_hind_offset_x}" 
             y_offset="-${hip_offset_y}" 
             z_offset="${hip_offset_z}" />

</robot>
